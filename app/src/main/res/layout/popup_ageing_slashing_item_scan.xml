                app:layout_constraintStart_toStartOf="@+id/tv_aging_slash_popup_sticker_lbnow"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_aging_slash_popup_sticker_mark"
