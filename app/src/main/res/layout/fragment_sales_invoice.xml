<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.salesinvoice.SalesInvoiceFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp">

        <TextView
            android:id="@+id/TextView1"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Bill No."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sales_invoice_invoiceno"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center|center"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloRed"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_sales_invoice_invoicedate"
            app:layout_constraintStart_toEndOf="@+id/TextView1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sales_invoice_invoicedate"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center|center"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloRed"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/ch_sales_invoice_reprint"
            app:layout_constraintTop_toTopOf="parent" />

        <ListView
            android:id="@+id/lv_sales_invoice_items"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toTopOf="@+id/ch_sales_invoice_loyalty"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView3"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Item Details"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView4"
            app:layout_constraintStart_toEndOf="@+id/TextView19"
            app:layout_constraintTop_toTopOf="@+id/TextView19" />

        <TextView
            android:id="@+id/TextView19"
            android:layout_width="35dp"
            android:layout_height="33dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center|center"
            android:hint=""
            android:padding="8dp"
            android:text="No."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView1" />

        <TextView
            android:id="@+id/TextView4"
            android:layout_width="50dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Qty."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView5"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView5"
            android:layout_width="65dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Rate"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView6"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView6"
            android:layout_width="60dp"
            android:layout_height="33dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Disc."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/bt_sales_invoice_add_items"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView8"
            android:layout_width="105dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left|center"
            android:hint=""
            android:padding="10dp"
            android:text="Net. Amount"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/TextView9"
            app:layout_constraintEnd_toStartOf="@+id/tv_sales_invoice_netamount"
            app:layout_constraintStart_toStartOf="@+id/TextView9" />

        <TextView
            android:id="@+id/TextView10"
            android:layout_width="105dp"
            android:layout_height="40dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left|center"
            android:hint=""
            android:padding="10dp"
            android:text="Tot. Discount"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/TextView8"
            app:layout_constraintStart_toStartOf="@+id/TextView8" />

        <TextView
            android:id="@+id/TextView17"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left|center"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/ch_sales_invoice_payment_mode"
            app:layout_constraintStart_toEndOf="@+id/ch_sales_invoice_loyalty"
            app:layout_constraintTop_toTopOf="@+id/ch_sales_invoice_payment_mode" />

        <TextView
            android:id="@+id/tv_sales_invoice_total_discount"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="right|center"
            android:hint="0.00"
            android:padding="10dp"
            android:textColor="@color/colorBlue"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView10" />

        <TextView
            android:id="@+id/tv_sales_invoice_netamount"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="right|center"
            android:hint="0.00"
            android:padding="10dp"
            android:textColor="@color/colorBlue"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView8" />

        <TextView
            android:id="@+id/TextView9"
            android:layout_width="105dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left|center"
            android:hint=""
            android:padding="10dp"
            android:text="Paid Amount"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/TextView11"
            app:layout_constraintEnd_toStartOf="@+id/et_sales_invoice_paidamt"
            app:layout_constraintStart_toStartOf="@+id/TextView11" />

        <EditText
            android:id="@+id/et_sales_invoice_paidamt"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="right|center"
            android:hint="0.00"
            android:padding="10dp"
            android:inputType="numberDecimal"
            android:textColor="@color/coloBlack"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView9" />

        <TextView
            android:id="@+id/TextView11"
            android:layout_width="105dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left|center"
            android:hint=""
            android:padding="10dp"
            android:text="Change"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_sales_invoice_change" />

        <TextView
            android:id="@+id/tv_sales_invoice_change"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="right|center"
            android:hint="0.00"
            android:padding="10dp"
            android:textColor="@color/colorBlue"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView11" />

        <Button
            android:id="@+id/bt_sales_invoice_save"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/btn_custom1"
            android:text="Save"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="@+id/TextView11"
            app:layout_constraintEnd_toStartOf="@+id/TextView11"
            app:layout_constraintHorizontal_bias="0.47"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_sales_invoice_clear" />

        <Button
            android:id="@+id/bt_sales_invoice_clear"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/btn_custom1"
            android:text="Clear"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@+id/TextView11"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView10" />

        <Button
            android:id="@+id/bt_sales_invoice_add_items"
            android:layout_width="55dp"
            android:layout_height="0dp"
            android:background="@drawable/btn_custom1"
            android:text="Add"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/TextView3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <CheckBox
            android:id="@+id/ch_sales_invoice_payment_mode"
            android:layout_width="135dp"
            android:layout_height="40dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:text="Payment Mode"
            app:layout_constraintBottom_toTopOf="@+id/TextView10"
            app:layout_constraintEnd_toEndOf="parent" />

        <CheckBox
            android:id="@+id/ch_sales_invoice_loyalty"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:enabled="false"
            android:background="@drawable/et_custom"
            android:text="Loyalty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ch_sales_invoice_payment_mode" />

        <CheckBox
            android:id="@+id/ch_sales_invoice_reprint"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:text="Reprint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>