<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/bt_grn_transfer_rfid_details_scan_itemcode"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="4dp"
        android:text="Itemcode"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_grn_transfer_rfid_details_scan_rfid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/bt_grn_transfer_rfid_details_diff_nonrfid"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="4dp"
        android:text="NON"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_grn_transfer_rfid_details_load"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/bt_grn_transfer_rfid_details_scan_rfid"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="4dp"
        android:text="RFID"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_grn_transfer_rfid_details_scan_nonrfid"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/bt_grn_transfer_rfid_details_scan_nonrfid"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="4dp"
        android:text="NON"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_grn_transfer_rfid_details_diff_rfid"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/bt_grn_transfer_rfid_details_diff_rfid"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="4dp"
        android:text="RFID"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_grn_transfer_rfid_details_diff_nonrfid"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_grn_transfer_rfid_details_load"
        android:layout_width="40dp"
        android:layout_height="24dp"
        android:background="@drawable/btn_custom1"
        android:text="..."
        android:textAllCaps="false"
        android:textSize="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/bt_grn_transfer_rfid_details_scan_itemcode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bt_grn_transfer_rfid_details_scan_itemcode" />



</androidx.constraintlayout.widget.ConstraintLayout>
