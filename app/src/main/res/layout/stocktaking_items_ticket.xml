<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_stocktaking_tickte_itemcode"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="12dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_stocktaking_tickte_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_stocktaking_tickte_date"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="12dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_stocktaking_tickte_time"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_stocktaking_tickte_time"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:textColor="@color/coloBlack"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>