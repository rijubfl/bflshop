<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">
        <TextView
            android:id="@+id/textView1"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:text="Select Date"
            android:layout_marginTop="5dp"
            android:padding="8dp"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/et_date_from"

            />

        <TextView
            android:id="@+id/et_date_from"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:padding="10dp"
            android:hint="Date From"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:onClick="showDatePickerDialog"
            android:layout_marginLeft="5dp"
            app:layout_constraintStart_toEndOf="@+id/textView1"
            app:layout_constraintEnd_toStartOf="@+id/et_date_to"
            app:layout_constraintTop_toTopOf="@id/textView1"
            />

        <TextView
            android:id="@+id/et_date_to"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:gravity="left"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:layout_marginLeft="5dp"
            android:hint="Date To"
            app:layout_constraintStart_toEndOf="@+id/et_date_from"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintTop_toTopOf="@id/textView1"

            />


        <TextView
            android:id="@+id/textView"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:text="Zone"
            android:layout_marginTop="5dp"
            android:padding="8dp"
            android:textSize="14dp"
            app:layout_constraintTop_toBottomOf="@id/et_date_from"
            app:layout_constraintStart_toStartOf="parent"

            />

        <Spinner
            android:id="@+id/sp_stocktaking_zone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:textSize="14dp"

            app:layout_constraintStart_toEndOf="@+id/textView"
            app:layout_constraintTop_toTopOf="@+id/textView"
            app:layout_constraintEnd_toStartOf="@+id/button_load"
            />

        <Button
            android:id="@+id/button_load"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:padding="8dp"
            android:text="Load"
            android:background="@color/colorBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sp_stocktaking_zone"
            app:layout_constraintTop_toTopOf="@+id/sp_stocktaking_zone"
            >
        </Button>

        <TextView
            android:id="@+id/textView4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:padding="5dp"
            android:textColor="@color/coloBlack"
            android:textStyle="bold"
            android:text="Stock Take Report Manual Entry"
            android:textSize="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sp_stocktaking_zone" />


        <TextView
            android:id="@+id/TextView2"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Zone"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />

        <TextView
            android:id="@+id/tv_zone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:layout_marginLeft="5dp"
            android:text=""
            android:layout_marginTop="10dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"


            app:layout_constraintStart_toEndOf="@id/TextView2"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/TextView3"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Qty"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_zone"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_Qty"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text=""
            android:layout_marginLeft="5dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:layout_marginTop="10dp"
            android:textStyle="bold"

            app:layout_constraintStart_toEndOf="@id/TextView3"
            app:layout_constraintTop_toBottomOf="@+id/tv_zone"
            app:layout_constraintEnd_toEndOf="parent"
            />


        <TextView
            android:id="@+id/TextView8"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Manual Count"

            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_Qty"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_Manual"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@color/colorBackPopup"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text=""
            android:inputType="number"
            android:layout_marginLeft="5dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:layout_marginTop="10dp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/TextView8"
            app:layout_constraintTop_toBottomOf="@+id/tv_Qty"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/TextView9"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Time"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/TextView5"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_Time"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text=""
            android:inputType="number"
            android:textColor="@color/coloBlack"
            android:layout_marginLeft="5dp"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toEndOf="@id/TextView9"
            app:layout_constraintTop_toBottomOf="@+id/et_User"
            app:layout_constraintEnd_toEndOf="parent"
           />

<!--        <Button-->
<!--            android:id="@+id/button_diff"-->
<!--            android:layout_width="70dp"-->
<!--            android:layout_height="40dp"-->
<!--            android:layout_marginLeft="5dp"-->
<!--            android:padding="8dp"-->
<!--            android:text="Diff."-->
<!--            android:textAllCaps="false"-->
<!--            android:background="@color/colorBtn"-->
<!--            app:layout_constraintStart_toEndOf="@+id/tv_time"-->
<!--            app:layout_constraintTop_toTopOf="@+id/TextView9"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            />-->
<!--        </Button>-->

        <TextView
            android:id="@+id/TextView10"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Diff."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/TextView9"
            app:layout_constraintStart_toStartOf="parent"

           />

        <TextView
            android:id="@+id/tv_Diff"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"

            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toEndOf="@id/TextView10"
            app:layout_constraintTop_toBottomOf="@+id/tv_Time"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/TextView5"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="User"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:layout_marginTop="10dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/TextView8"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/et_User"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:layout_marginLeft="5dp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toEndOf="@id/TextView5"
            app:layout_constraintTop_toBottomOf="@+id/et_Manual"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <Button
            android:id="@+id/button_clear"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginRight="10dp"

            android:padding="8dp"
            android:text="Clear"
            android:textStyle="bold"
            android:background="@color/colorBtn"
            app:layout_constraintTop_toBottomOf="@id/tv_Diff"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_save"
            >
        </Button>

        <Button
            android:id="@+id/button_save"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginLeft="10dp"
            android:padding="8dp"
            android:text="Save"
            android:textStyle="bold"
            android:background="@color/colorBtn"
            app:layout_constraintTop_toBottomOf="@id/tv_Diff"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toEndOf="@id/button_clear"
            app:layout_constraintEnd_toEndOf="parent"
            >
        </Button>


        <!--        <ListView-->
<!--            android:id="@+id/lv_stock_taking"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="0dp"-->
<!--            android:background="@drawable/et_custom_total"-->
