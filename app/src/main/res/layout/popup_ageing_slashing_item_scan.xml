        android:hint="Trfno"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_itemname" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_itemname"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:hint="Itemname"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_aging_slash_popup_scan_trfno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_itemcode" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_addinfo"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/et_custom"
        android:hint="Add Info"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_aging_slash_popup_scan_itemcode"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_itemcode" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_department"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:hint="Group | Department | Division"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_itemname" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_currprice"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:gravity="right"
        android:hint="Current Price"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_department" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_newprice"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/et_custom"
        android:gravity="right"
        android:hint="New Price"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toEndOf="@+id/tv_aging_slash_popup_scan_currprice"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_currprice" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_labeltype"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:hint="Label Type"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_aging_slash_popup_scan_saveperc"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_currprice" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_saveperc"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:hint="100"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_currprice" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_slashtype"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/et_custom"
        android:hint="Slash Type"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_aging_slash_popup_scan_newprice"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_currprice" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_new_barcode"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:hint="New Barcode"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_aging_slash_popup_scan_labeltype"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_currprice" />

    <Button
        android:id="@+id/bt_aging_slash_popup_scan_test_red"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/btn_custom1"
        android:text="Test (Red)"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_aging_slash_popup_scan_test_white"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_new_barcode" />

    <Button
        android:id="@+id/bt_aging_slash_popup_scan_test_white"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/btn_custom1"
        android:text="Test (White)"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_new_barcode" />

    <Button
        android:id="@+id/bt_aging_slash_popup_scan_test_yellow"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/btn_custom1"
        android:text="Test (Yellow)"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_aging_slash_popup_scan_test_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_new_barcode" />

    <Button
        android:id="@+id/bt_aging_slash_popup_scan_close"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="5dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:text="   "
        android:textColor="@color/colorAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />

