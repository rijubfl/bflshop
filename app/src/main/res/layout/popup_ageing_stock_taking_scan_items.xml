<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="370dp"
    android:padding="8dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="420dp">

    <CheckBox
        android:id="@+id/ch_ageing_stock_taking_popup_main_server"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/et_custom"
        android:text="Connect Main Server"
        android:textSize="18dp"
        android:enabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_ageing_stock_taking_popup_barcode"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:hint="Scan Barcode / RFID"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_ageing_stock_taking_popup_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ch_ageing_stock_taking_popup_main_server" />

    <TextView
        android:id="@+id/tv_ageing_stock_taking_popup_last_barcode"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:hint="Last Scan Barcode"
        android:padding="10dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ageing_stock_taking_popup_last" />

    <TextView
        android:id="@+id/tv_ageing_stock_taking_popup_last_rfid"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:hint="Last Scan RFID"
        android:padding="10dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ageing_stock_taking_popup_last_barcode" />

    <TextView
        android:id="@+id/tv_ageing_stock_taking_popup_last"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/et_custom"
        android:hint="Last Scan"
        android:padding="10dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_ageing_stock_taking_popup_barcode" />

    <TextView
        android:id="@+id/tv_ageing_stock_taking_popup_result"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/et_custom"
        android:hint="Result"
        android:padding="10dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ageing_stock_taking_popup_last_rfid" />

    <Button
        android:id="@+id/bt_ageing_stock_taking_popup_close"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/bt_ageing_stock_taking_popup_add"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_custom1"
        android:text="ADD"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/et_ageing_stock_taking_popup_barcode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_ageing_stock_taking_popup_barcode" />



</androidx.constraintlayout.widget.ConstraintLayout>