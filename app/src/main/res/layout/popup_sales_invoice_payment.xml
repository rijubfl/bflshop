<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="375dp"
    android:padding="6dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="450dp">

    <TextView
        android:id="@+id/TextView1"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:text="Payment."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/sp_sales_invoice_popup_payment_type"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:ems="10"
        android:padding="10dp"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_sales_invoice_popup_payment_show_typ"
        app:layout_constraintStart_toEndOf="@+id/TextView1"
        app:layout_constraintTop_toTopOf="@+id/TextView1" />

    <Button
        android:id="@+id/bt_sales_invoice_popup_payment_show_typ"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_custom1"
        android:text=">>>"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/TextView1" />

    <TextView
        android:id="@+id/TextView5"
        android:layout_width="120dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="6dp"
        android:text="Payment Type"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TextView1" />

    <TextView
        android:id="@+id/TextView10"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="6dp"
        android:text="Reference No."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/TextView7"
        app:layout_constraintStart_toEndOf="@+id/TextView5"
        app:layout_constraintTop_toTopOf="@+id/TextView5" />

    <TextView
        android:id="@+id/TextView7"
        android:layout_width="70dp"
        android:layout_height="35dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="6dp"
        android:text="Amount"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/TextView16"
        app:layout_constraintTop_toTopOf="@+id/TextView5" />

    <TextView
        android:id="@+id/TextView16"
        android:layout_width="40dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/TextView5" />

    <ListView
        android:id="@+id/lv_sales_invoice_popup_payment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/et_custom_total"
        app:layout_constraintBottom_toTopOf="@+id/TextView8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TextView5" />

    <TextView
        android:id="@+id/TextView8"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="8dp"
        android:layout_marginBottom="5dp"
        android:text="Total"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/bt_sales_invoice_popup_close"
        app:layout_constraintEnd_toStartOf="@+id/tv_sales_invoice_popup_payment_totalamt_net"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_sales_invoice_popup_payment_totalamt"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:hint=""
        android:padding="6dp"
        android:text="0.00"
        android:textColor="@color/coloRed"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_sales_invoice_popup_payment_totalamt_net" />

    <TextView
        android:id="@+id/tv_sales_invoice_popup_payment_totalamt_net"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:hint=""
        android:padding="6dp"
        android:text="0.00"
        android:textColor="@color/coloBlack"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_sales_invoice_popup_payment_totalamt_balance"
        app:layout_constraintTop_toTopOf="@+id/TextView8" />

    <TextView
        android:id="@+id/tv_sales_invoice_popup_payment_totalamt_balance"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:hint=""
        android:padding="6dp"
        android:text="0.00"
        android:textColor="@color/colorGreen"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_sales_invoice_popup_payment_totalamt"
        app:layout_constraintTop_toTopOf="@+id/tv_sales_invoice_popup_payment_totalamt_net" />

    <Button
        android:id="@+id/bt_sales_invoice_popup_close"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>