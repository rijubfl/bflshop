<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.grntransfer.grnnew.GrnTransferNewFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp">

        <!--
            Clear All moved off the bottom row (away from Save) and up into the
            top-right corner as a small icon-only button, same treatment as the
            GIN verification screen:
              - Far from Save/Scan Item, so scanning motion can't mis-tap it.
              - Small (36dp icon) so it requires a deliberate, precise tap.
              - Still red-tinted (kept your original alarm cue via backgroundTint)
                but the small footprint removes the accidental-tap risk.
            View + Transfer checkboxes shifted left to make room for it.
            Add a confirmation dialog on click in the Fragment as a second
            safety net before it actually clears.
        -->

        <ImageButton
            android:id="@+id/bt_grn_transfer_clear_all"
            android:layout_width="75dp"
            android:layout_height="44dp"
            android:background="@drawable/et_custom"
            android:backgroundTint="@color/coloRed"
            android:contentDescription="Clear All"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/delete_outline"
            app:layout_constraintBottom_toBottomOf="@+id/bt_grn_transfer_save"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bt_grn_transfer_save"
            app:tint="@color/colorWhite"
            tools:ignore="TouchTargetSizeCheck" />

        <CheckBox
            android:id="@+id/ch_grn_transfer_view"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:text="View"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ch_grn_transfer_trffrom_oth_shop" />

        <CheckBox
            android:id="@+id/ch_grn_transfer_trffrom_oth_shop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:text="Transfer Received From Other Shop"
            app:layout_constraintEnd_toStartOf="@+id/ch_grn_transfer_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/et_grn_transfer_rfid_ginno"
            android:layout_width="140dp"
            android:layout_height="45dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:hint="GIN Number"
            android:inputType="number"
            android:padding="8dp"
            android:textColor="@color/coloRed"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ch_grn_transfer_trffrom_oth_shop" />

        <EditText
            android:id="@+id/et_grn_transfer_trfno_entryno"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:hint="Transfer No. / Tote Id / Entry No."
            android:inputType="textEmailAddress"
            android:padding="8dp"
            android:textColor="@color/coloRed"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/et_grn_transfer_rfid_ginno"
            app:layout_constraintTop_toTopOf="@+id/et_grn_transfer_rfid_ginno" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_load_scan_mid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <Button
            android:id="@+id/bt_grn_transfer_load"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/btn_custom1"
            android:text="Load Transfer"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/guide_load_scan_mid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_grn_transfer_rfid_ginno" />

        <Button
            android:id="@+id/bt_grn_transfer_scan"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/btn_custom1"
            android:text="Scan Item"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guide_load_scan_mid"
            app:layout_constraintTop_toTopOf="@+id/bt_grn_transfer_load" />

        <TextView
            android:id="@+id/tv_grn_transfer_shopname"
            android:layout_width="00dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_grn_transfer_trfdate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_grn_transfer_load" />

        <TextView
            android:id="@+id/tv_grn_transfer_trfdate"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_grn_transfer_toteid"
            app:layout_constraintTop_toTopOf="@+id/tv_grn_transfer_shopname" />

        <TextView
            android:id="@+id/tv_grn_transfer_toteid"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_grn_transfer_shopname" />

        <TextView
            android:id="@+id/tv_grn_transfer_total_scan_qty"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="8dp"
            android:text="0"
            android:textAlignment="center"
            android:textColor="@color/colorGreen"
            android:textSize="24dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_grn_transfer_total_trf_qty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_grn_transfer_total_trf_qty" />

        <TextView
            android:id="@+id/TextView13"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="5dp"
            android:text="Scan Qty"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_grn_transfer_total_scan_qty"
            app:layout_constraintEnd_toEndOf="@+id/tv_grn_transfer_total_scan_qty"
            app:layout_constraintStart_toStartOf="@+id/tv_grn_transfer_total_scan_qty" />

        <TextView
            android:id="@+id/TextView16"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="5dp"
            android:text="Transfer Qty"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_grn_transfer_total_trf_qty"
            app:layout_constraintEnd_toEndOf="@+id/tv_grn_transfer_total_trf_qty"
            app:layout_constraintStart_toStartOf="@+id/tv_grn_transfer_total_trf_qty" />

        <TextView
            android:id="@+id/TextView19"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="5dp"
            android:text="Difference"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_grn_transfer_total_diff_qty"
            app:layout_constraintEnd_toEndOf="@+id/tv_grn_transfer_total_diff_qty"
            app:layout_constraintStart_toStartOf="@+id/tv_grn_transfer_total_diff_qty" />

        <TextView
            android:id="@+id/tv_grn_transfer_total_trf_qty"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="8dp"
            android:text="0"
            android:textAlignment="center"
            android:textColor="@color/colorGreen"
            android:textSize="25dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tv_grn_transfer_last_save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_grn_transfer_total_diff_qty"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="8dp"
            android:text="0"
            android:textAlignment="center"
            android:textColor="@color/coloRed"
            android:textSize="25dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_grn_transfer_total_trf_qty"
            app:layout_constraintTop_toTopOf="@+id/tv_grn_transfer_total_trf_qty" />

        <TextView
            android:id="@+id/TextView25"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:text="Scan Details"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_grn_transfer_shopname" />

        <TextView
            android:id="@+id/TextView2"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Itemcode"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView25" />

        <TextView
            android:id="@+id/TextView3"
            android:layout_width="60dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Trf"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView8"
            app:layout_constraintTop_toTopOf="@+id/TextView2" />

        <TextView
            android:id="@+id/TextView8"
            android:layout_width="60dp"
            android:layout_height="33dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Diff"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView888"
            app:layout_constraintTop_toTopOf="@+id/TextView2" />

        <TextView
            android:id="@+id/TextView4"
            android:layout_width="60dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Scan"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView3"
            app:layout_constraintTop_toTopOf="@+id/TextView2" />

        <TextView
            android:id="@+id/TextView888"
            android:layout_width="50dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView2" />

        <ListView
            android:id="@+id/lv_grn_transfer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toTopOf="@+id/TextView16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView2" />

        <TextView
            android:id="@+id/tv_grn_transfer_last_save"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:hint="Last Saved"
            android:inputType="textEmailAddress"
            android:padding="8dp"
            android:textColor="@color/colorBlue"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/bt_grn_transfer_save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!--
            Save is now alone on the bottom row, full width. Nothing else lives
            in its tap zone, so there's no adjacent button to fat-finger into.
            (Clear All lives up top now — see the ImageButton near the checkboxes.)
        -->

        <Button
            android:id="@+id/bt_grn_transfer_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginBottom="2dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/btn_custom1"
            android:text="Save"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_grn_transfer_clear_all" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>