<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.ageingslashing.wify.AgeingSlashingWifyFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp">

        <TextView
            android:id="@+id/tv_ageing_slashing_date"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="10dp"
            android:text="15/08/2022"
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/ly_ageing_slashing_baterry_percentage"
            app:layout_constraintTop_toTopOf="@+id/tv_ageing_slashing_batchno" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_ageing_slashing_baterry_percentage"
            android:layout_width="75dp"
            android:layout_height="0dp"
            android:padding="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_ageing_slashing_batchno"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_ageing_slashing_user">

            <TextView
                android:id="@+id/TextView17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/et_custom"
                android:gravity="center|center"
                android:hint=""
                android:padding="8dp"
                android:text="Battery"
                android:textColor="@color/coloBlack"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"></TextView>

            <TextView
                android:id="@+id/tv_ageing_slashing_battery_percentage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/et_custom"
                android:hint=""
                android:padding="0dp"
                android:text="100 %"
                android:gravity="center|center"
                android:textColor="@color/colorGreen"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/TextView17"></TextView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_ageing_slashing_user"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="10dp"
            android:text="1743"
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_ageing_slashing_shop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="10dp"
            android:text="BFLDFC"
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/ly_ageing_slashing_baterry_percentage"
            app:layout_constraintStart_toEndOf="@+id/tv_ageing_slashing_user"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/TextView6"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Total."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/bt_ageing_slashing_delete"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_ageing_slashing_total_scan"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="8dp"
            android:text="0"
            android:textAlignment="center"
            android:textColor="@color/coloRed"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/bt_ageing_slashing_delete"
            app:layout_constraintStart_toEndOf="@+id/TextView6"
            app:layout_constraintTop_toTopOf="@+id/TextView6" />

        <TextView
            android:id="@+id/TextView7"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Exported."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="@+id/bt_ageing_slashing_clear"
            app:layout_constraintTop_toTopOf="@+id/TextView6" />

        <TextView
            android:id="@+id/tv_ageing_slashing_total_exported"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="8dp"
            android:text="0"
            android:textAlignment="center"
            android:textColor="@color/coloRed"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView7"
            app:layout_constraintTop_toTopOf="@+id/TextView6" />

        <TextView
            android:id="@+id/TextView1"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Batch"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_ageing_slashing_batchno" />

        <TextView
            android:id="@+id/tv_ageing_slashing_batchno"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:padding="8dp"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_ageing_slashing_date"
            app:layout_constraintStart_toEndOf="@+id/TextView1"
            app:layout_constraintTop_toBottomOf="@+id/tv_ageing_slashing_user" />

        <TextView
            android:id="@+id/TextView15"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Last 50 item Scanned"
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sp_ageing_printer_white" />

        <TextView
            android:id="@+id/TextView2"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Scan Items"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView15" />

        <TextView
            android:id="@+id/TextView3"
            android:layout_width="70dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="New"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView8"
            app:layout_constraintTop_toTopOf="@+id/TextView2" />

        <TextView
            android:id="@+id/TextView8"
            android:layout_width="40dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="LB"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView2" />

        <TextView
            android:id="@+id/TextView4"
            android:layout_width="70dp"
            android:layout_height="33dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left|center"
            android:hint=""
            android:padding="8dp"
            android:text="Old"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView3"
            app:layout_constraintTop_toTopOf="@+id/TextView2" />

        <ListView
            android:id="@+id/lv_ageing_slashing"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toTopOf="@+id/TextView6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView2" />

        <Spinner
            android:id="@+id/sp_ageing_printer_name"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:ems="10"
            android:padding="10dp"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/sp_ageing_printer_yellow" />

        <Spinner
            android:id="@+id/sp_ageing_printer_yellow"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/border_yellow"
            android:ems="10"
            android:padding="10dp"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/ch_ageing_printer_yellow_active"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView1" />

        <CheckBox
            android:id="@+id/ch_ageing_printer_yellow_active"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:checked="true"
            android:background="@drawable/et_custom"
            android:text="Active"
            app:layout_constraintEnd_toStartOf="@+id/sp_ageing_printer_name"
            app:layout_constraintTop_toTopOf="@+id/sp_ageing_printer_yellow" />

        <Spinner
            android:id="@+id/sp_ageing_printer_red"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/border_red"
            android:ems="10"
            android:padding="10dp"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/ch_ageing_printer_red_active"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sp_ageing_printer_yellow" />

        <CheckBox
            android:id="@+id/ch_ageing_printer_red_active"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:checked="true"
            android:background="@drawable/et_custom"
            android:text="Active"
            app:layout_constraintEnd_toStartOf="@+id/sp_ageing_printer_name"
            app:layout_constraintTop_toTopOf="@+id/sp_ageing_printer_red" />

        <Spinner
            android:id="@+id/sp_ageing_printer_white"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/border_white"
            android:ems="10"
            android:padding="10dp"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/ch_ageing_printer_white_active"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sp_ageing_printer_red" />

        <CheckBox
            android:id="@+id/ch_ageing_printer_white_active"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:checked="true"
            android:background="@drawable/et_custom"
            android:text="Active"
            app:layout_constraintEnd_toStartOf="@+id/sp_ageing_printer_name"
            app:layout_constraintTop_toTopOf="@+id/sp_ageing_printer_white" />

        <Button
            android:id="@+id/bt_ageing_slashing_add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/btn_custom1"
            android:text="Scan Barcode"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/sp_ageing_printer_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/sp_ageing_printer_name"
            app:layout_constraintTop_toTopOf="@+id/sp_ageing_printer_red" />

        <Button
            android:id="@+id/bt_ageing_slashing_clear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_custom1"
            android:text="Clear All"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView2"
            app:layout_constraintTop_toTopOf="@+id/bt_ageing_slashing_delete" />

        <Button
            android:id="@+id/bt_ageing_slashing_delete"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/btn_custom1"
            android:text="Delete"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/textView2"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="5dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:text="   "
            android:textColor="@color/colorAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="SpeakableTextPresentCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>