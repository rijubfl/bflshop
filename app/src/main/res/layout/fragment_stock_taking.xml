<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.stocktaking.manual.StockTakingFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <TextView
            android:id="@+id/textView4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:padding="5dp"
            android:textColor="@color/coloBlack"
            android:text="Last 50 item Scanned by User: "
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stock_taking_total_count" />

        <ListView
            android:id="@+id/lv_stock_taking"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />

        <EditText
            android:id="@+id/et_stock_taking_itemcode"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_stock_taking_main_itemcode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:textColor="@color/coloRed"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/TextView1"
            app:layout_constraintTop_toBottomOf="@+id/et_stock_taking_itemcode"
            tools:text="" />

        <TextView
            android:id="@+id/tv_stock_taking_description"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:inputType="text"
            android:padding="5dp"
            android:textColor="@color/coloRed"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/TextView1"
            app:layout_constraintTop_toBottomOf="@+id/tv_stock_taking_main_itemcode"
            tools:text="" />

        <TextView
            android:id="@+id/TextView1"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:text="Total"
            android:textColor="@color/coloRed"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stock_taking_description" />

        <TextView
            android:id="@+id/tv_stock_taking_total_count"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:textColor="@color/coloRed"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/TextView1"
            app:layout_constraintStart_toStartOf="@+id/TextView1"
            app:layout_constraintTop_toBottomOf="@+id/TextView1"
            tools:text="" />

        <TextView
            android:id="@+id/TextView11"
            android:layout_width="130dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:text="User"
            android:textColor="@color/coloRed"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@+id/TextView1"
            app:layout_constraintTop_toTopOf="@+id/TextView1" />

        <TextView
            android:id="@+id/tv_stock_taking_user_count"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:textColor="@color/coloRed"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/TextView11"
            app:layout_constraintStart_toEndOf="@+id/TextView1"
            app:layout_constraintTop_toBottomOf="@+id/TextView11"
            tools:text="" />

        <TextView
            android:id="@+id/TextView111"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:text="Item"
            android:textColor="@color/coloRed"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView11"
            app:layout_constraintTop_toTopOf="@+id/TextView1" />

        <TextView
            android:id="@+id/tv_stock_taking_item_count"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:textColor="@color/coloRed"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/TextView111"
            app:layout_constraintStart_toEndOf="@+id/TextView11"
            app:layout_constraintTop_toBottomOf="@+id/TextView111"
            tools:text="" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>