        android:layout_height="45dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint="Results"
        android:textAlignment="center"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textStyle="bold"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_aging_slash_popup_scan_barcode" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_el_qty_hide"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_aging_slash_popup_scan_el_qty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_barcode" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_el_qty_lbl"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:text="El.Qty."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_barcode" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_el_qty"
        android:layout_width="55dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"
        android:background="@drawable/et_custom"
        android:gravity="center"
        android:hint="0"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toEndOf="@+id/tv_aging_slash_popup_scan_el_qty_lbl"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_el_qty_lbl" />

    <TextView
        android:id="@+id/TextView21"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:text="Sc.Qty."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toEndOf="@+id/tv_aging_slash_popup_scan_el_qty"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_el_qty_lbl" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_sc_qty"
        android:layout_width="55dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"
        android:background="@drawable/et_custom"
        android:gravity="center"
        android:hint="0"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toEndOf="@+id/TextView21"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_el_qty_lbl" />

    <TextView
        android:id="@+id/TextView22"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:text="Sl.Qty."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toEndOf="@+id/tv_aging_slash_popup_scan_sc_qty"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_el_qty_lbl" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_sl_qty"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"
        android:background="@drawable/et_custom"
        android:gravity="center"
        android:hint="0"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/TextView22"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_slash_popup_scan_sc_qty" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_itemcode"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:hint="Itemcode"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_sc_qty" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_trfno"
