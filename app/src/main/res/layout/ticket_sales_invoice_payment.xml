<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_ticket_sales_invoice_payment_type"
        android:layout_width="120dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_ticket_sales_invoice_payment_refno"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_ticket_sales_invoice_payment_amount"
        app:layout_constraintStart_toEndOf="@+id/tv_ticket_sales_invoice_payment_type"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_sales_invoice_payment_type" />

    <TextView
        android:id="@+id/tv_ticket_sales_invoice_payment_amount"
        android:layout_width="70dp"
        android:layout_height="35dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right|center"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_ticket_sales_invoice_popup_payment_delete"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_sales_invoice_payment_type" />

    <Button
        android:id="@+id/bt_ticket_sales_invoice_popup_payment_delete"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:background="@drawable/btn_custom1"
        android:text="Delete"
        android:textAllCaps="false"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ticket_sales_invoice_payment_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_sales_invoice_payment_type" />

</androidx.constraintlayout.widget.ConstraintLayout>