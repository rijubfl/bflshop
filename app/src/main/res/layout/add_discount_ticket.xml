<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_add_discount_ticket_itemcode"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Itemcode"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_add_discount_ticket_disc_price"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_add_discount_ticket_disc_per"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:padding="5dp"
        android:text="Disc.Perc"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_add_discount_delete"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_add_discount_ticket_disc_price"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:padding="5dp"
        android:text="Price"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_add_discount_ticket_disc_per"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_add_discount_delete"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_weight="1"
        android:background="@color/colorBtn"
        android:text="DELETE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>