<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.shopreturns.ShopReturnsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <TextView
            android:id="@+id/TextView"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Category"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/sp_shop_returns_category"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/sp_shop_returns_category"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:ems="10"
            android:padding="10dp"
            android:text="[Select One..]"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView"
            app:layout_constraintTop_toTopOf="@+id/TextView" />

        <TextView
            android:id="@+id/tv_shop_returns_category_name"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:visibility="invisible"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView" />


        <!--        <Spinner-->
<!--            android:id="@+id/sp_select_shop"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="40dp"-->
<!--            android:layout_marginLeft="5dp"-->
<!--            android:layout_marginTop="12dp"-->
<!--            android:background="@drawable/et_custom"-->
<!--            android:ems="10"-->
<!--            android:padding="12dp"-->
<!--            android:textSize="14dp"-->
<!--            android:text="[Select Shop..]"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintEnd_toStartOf="@+id/bt_scan_itemcode"-->
<!--            app:layout_constraintTop_toBottomOf="@+id/sp_shop_returns_category"-->

<!--            />-->
        <TextView
            android:id="@+id/sp_select_shop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginRight="5dp"
            android:background="@android:drawable/editbox_background"
            android:gravity="center_vertical"
            android:hint="Select Shop"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/bt_scan_itemcode"
            app:layout_constraintEnd_toStartOf="@+id/bt_scan_itemcode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bt_scan_itemcode" />


        <Button
            android:id="@+id/bt_scan_itemcode"
            android:layout_width="120dp"
            android:layout_marginTop="8dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_custom1"
            android:text="Scan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView"></Button>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lyt_listheader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_scan_itemcode"
        app:layout_constraintBottom_toTopOf="@+id/listempty" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="5"

            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

                <TextView
                    android:id="@+id/TextView19"
                    android:layout_width="0dp"
                    android:layout_height="33dp"

                    android:background="@drawable/et_custom_total"
                    android:gravity="left|center"
                    android:hint=""
                    android:layout_weight="0.6"
                    android:padding="8dp"
                    android:text="No."
                    android:textColor="@color/coloBlack"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                   />

                <TextView
                    android:id="@+id/TextView3"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:background="@drawable/et_custom_total"
                    android:gravity="left|center"
                    android:hint=""
                    android:layout_weight="1.3"
                    android:padding="8dp"
                    android:text="Item Code"
                    android:textColor="@color/coloBlack"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/TextView4"
                    app:layout_constraintStart_toEndOf="@+id/TextView19"
                    app:layout_constraintTop_toTopOf="@+id/TextView19" />

                <TextView
                    android:id="@+id/TextView4"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/et_custom_total"
                    android:gravity="left|center"
                    android:hint=""
                    android:padding="8dp"
                    android:text="Item Desc"
                    android:textColor="@color/coloBlack"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/TextView9"
                    app:layout_constraintStart_toEndOf="@+id/TextView3"
                    app:layout_constraintTop_toTopOf="@+id/TextView3" />


                <TextView
                    android:id="@+id/TextView9"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/et_custom_total"
                    android:gravity="center"
                    android:hint=""
                    android:padding="8dp"
                    android:text="Qty"
                    android:textColor="@color/coloBlack"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/TextView5"
                    app:layout_constraintTop_toTopOf="@+id/TextView19" />

                <TextView
                    android:id="@+id/TextView5"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_weight="0.85"
                    android:layout_marginRight="5dp"
                    android:background="@drawable/et_custom_total"
                    android:gravity="center"
                    android:hint=""
                    android:padding="8dp"
                    android:text="S.price"
                    android:textColor="@color/coloBlack"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/TextView3" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/listempty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            android:text="Nothing to show"
            android:textColor="@color/colorAccent"
            app:layout_constraintBottom_toTopOf="@+id/lyt_listheader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lyt_listheader" />

        <!--        <TextView-->
<!--            android:id="@+id/TextView8"-->
<!--            android:layout_width="50dp"-->
<!--            android:layout_height="33dp"-->
<!--            android:background="@drawable/et_custom_total"-->
<!--            android:gravity="center"-->
<!--            android:hint=""-->
<!--            android:padding="8dp"-->
<!--            android:text=""-->
<!--            android:textColor="@color/coloBlack"-->
<!--            android:textSize="14dp"-->
<!--            android:textStyle="bold"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintTop_toTopOf="@+id/TextView19" />-->

        <ListView
            android:id="@+id/lv_shop_returns_scanitems"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toTopOf="@+id/tv_qtycount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lyt_listheader" />

        <TextView
            android:id="@+id/tv_qtycount"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:padding="10dp"
            android:text="Total QTY"
            app:layout_constraintBottom_toTopOf="@+id/et_remarks"
            app:layout_constraintEnd_toStartOf="@+id/tv_count"
            app:layout_constraintStart_toStartOf="parent"

            />


        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="8dp"
            android:padding="10dp"
            android:text="Count "
            android:textColor="@color/coloRed"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/et_remarks"
            app:layout_constraintStart_toEndOf="@+id/tv_qtycount"
             />

        <EditText
            android:id="@+id/et_remarks"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:hint="Remarks"
            android:layout_marginBottom="4dp"
            android:textSize="18sp"
            android:layout_marginRight="10dp"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toStartOf="@+id/btn_clear"
            app:layout_constraintBottom_toBottomOf="parent"
            >


        </EditText>



        <Button
            android:id="@+id/btn_clear"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Clear"
            android:textAllCaps="false"
            android:layout_marginBottom="4dp"
            android:background="@drawable/btn_custom1"
            android:textSize="18sp"
            android:layout_marginRight="10dp"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_count"
            app:layout_constraintStart_toEndOf="@id/et_remarks"
            app:layout_constraintEnd_toStartOf="@+id/bt_shop_returns_add"
            app:layout_constraintBottom_toBottomOf="parent"
            >


        </Button>


        <Button
            android:id="@+id/bt_shop_returns_add"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/btn_custom1"
            android:text="Save"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_count"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
             />
        <ProgressBar
            android:id="@+id/pr_shop_returns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>