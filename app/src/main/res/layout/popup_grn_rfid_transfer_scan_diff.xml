<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="380dp"
    android:padding="5dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="600dp">

    <TextView
        android:id="@+id/tv_popup_grn_rfid_transfer_diff_trfno"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom"
        android:hint="TrfNo"
        android:padding="6dp"
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TextView13"
        android:layout_width="115dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="Diff. Qty."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView7" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="115dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="Total. Qty."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_popup_grn_rfid_transfer_diff_trfno" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="115dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="Scan. Qty."
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/TextView13"
        app:layout_constraintStart_toEndOf="@+id/textView7"
        app:layout_constraintTop_toTopOf="@+id/textView7" />

    <TextView
        android:id="@+id/tv_popup_grn_rfid_transfer_total_rfidqty"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint=""
        android:padding="3dp"
        android:text="0"
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="22dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textView7"
        app:layout_constraintTop_toBottomOf="@+id/textView7" />

    <TextView
        android:id="@+id/tv_popup_grn_rfid_transfer_total_nonrfidqty"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint=""
        android:padding="3dp"
        android:text="0"
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="22dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView7"
        app:layout_constraintTop_toBottomOf="@+id/textView7" />

    <TextView
        android:id="@+id/tv_popup_grn_rfid_transfer_scan_rfidqty"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint=""
        android:padding="3dp"
        android:text="0"
        android:textAlignment="center"
        android:textColor="@color/colorGreen"
        android:textSize="22dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/textView11" />

    <TextView
        android:id="@+id/tv_popup_grn_rfid_transfer_scan_nonrfidqty"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint=""
        android:padding="3dp"
        android:text="0"
        android:textAlignment="center"
        android:textColor="@color/colorGreen"
        android:textSize="22dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView11"
        app:layout_constraintTop_toBottomOf="@+id/textView11" />

    <TextView
        android:id="@+id/tv_popup_grn_rfid_transfer_diff_rfidqty"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint=""
        android:padding="3dp"
        android:text="0"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="22dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/TextView13"
        app:layout_constraintTop_toBottomOf="@+id/TextView13" />

    <TextView
        android:id="@+id/tv_popup_grn_rfid_transfer_diff_nonrfidqty"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint=""
        android:padding="3dp"
        android:text="0"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="22dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/TextView13"
        app:layout_constraintTop_toBottomOf="@+id/TextView13" />

    <ListView
        android:id="@+id/lv_popup_grn_rfid_transfer_diff_trfdetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/et_custom_total"
        app:layout_constraintBottom_toTopOf="@+id/bt_popup_grn_rfid_transfer_diff_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView19" />

    <Button
        android:id="@+id/bt_popup_grn_rfid_transfer_diff_close"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView19"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginRight="2dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="Itemcode"
        android:textColor="@color/coloBlack"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textView22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_popup_grn_rfid_transfer_diff_trfno_scan_barcode" />

    <Button
        android:id="@+id/bt_popup_grn_rfid_transfer_diff_trfno_scan_barcode"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/btn_custom1"
        android:text="Scan Barcode"
        android:textAllCaps="false"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_popup_grn_rfid_transfer_diff_trfno_scan_rfid"
        app:layout_constraintTop_toTopOf="@+id/ch_popup_grn_transfer_rfid_view_showpending" />

    <Button
        android:id="@+id/bt_popup_grn_rfid_transfer_diff_trfno_scan_rfid"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_custom1"
        android:text="Scan Rfid"
        android:textAllCaps="false"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ch_popup_grn_transfer_rfid_view_showpending" />

    <CheckBox
        android:id="@+id/ch_popup_grn_transfer_rfid_view_showpending"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:checked="true"
        android:background="@drawable/et_custom"
        android:text="Show Diff."
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_popup_grn_rfid_transfer_diff_trfno_scan_barcode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_popup_grn_rfid_transfer_total_rfidqty" />

    <TextView
        android:id="@+id/textView21"
        android:layout_width="100dp"
        android:layout_height="26dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="Difference"
        android:textColor="@color/coloBlack"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textView20"
        app:layout_constraintTop_toTopOf="@+id/textView19" />

    <TextView
        android:id="@+id/textView23"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="RFID"
        android:textColor="@color/coloBlack"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textView21"
        app:layout_constraintTop_toBottomOf="@+id/textView21" />

    <TextView
        android:id="@+id/textView25"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="NON"
        android:textColor="@color/coloBlack"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView21"
        app:layout_constraintTop_toBottomOf="@+id/textView21" />

    <TextView
        android:id="@+id/textView22"
        android:layout_width="100dp"
        android:layout_height="26dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="Scan"
        android:textColor="@color/coloBlack"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textView21"
        app:layout_constraintTop_toTopOf="@+id/textView19" />

    <TextView
        android:id="@+id/textView30"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="NON"
        android:textColor="@color/coloBlack"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView22"
        app:layout_constraintTop_toBottomOf="@+id/textView22" />

    <TextView
        android:id="@+id/textView26"
        android:layout_width="50dp"
        android:layout_height="26dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="RFID"
        android:textColor="@color/coloBlack"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textView22"
        app:layout_constraintTop_toBottomOf="@+id/textView22" />

    <TextView
        android:id="@+id/textView20"
        android:layout_width="42dp"
        android:layout_height="52dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right|center"
        android:hint=""
        android:padding="5dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView19" />

</androidx.constraintlayout.widget.ConstraintLayout>