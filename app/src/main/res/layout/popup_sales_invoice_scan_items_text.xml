<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="370dp"
    android:padding="5dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="227dp">

    <Spinner
        android:id="@+id/sp_sales_invoice_popup_scan_item_barcode"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/et_custom"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_sales_invoice_popup_scan_item_barcode"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:hint="RFID / Barcode"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sp_sales_invoice_popup_scan_item_barcode" />

    <TextView
        android:id="@+id/TextView1"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:gravity="left|center"
        android:hint=""
        android:padding="10dp"
        android:text="Sales Price."
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_sales_invoice_popup_scan_item_barcode" />

    <TextView
        android:id="@+id/TextView12"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:gravity="left|center"
        android:hint=""
        android:padding="10dp"
        android:text="Quantity."
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TextView1" />

    <EditText
        android:id="@+id/et_sales_invoice_popup_scan_item_qty"
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/et_custom"
        android:gravity="right|center"
        android:padding="10dp"
        android:text="1"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintStart_toEndOf="@+id/TextView12"
        app:layout_constraintTop_toTopOf="@+id/TextView12" />

    <Spinner
        android:id="@+id/sp_sales_invoice_popup_scan_item_salesprice"
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/et_custom"
        android:ems="10"
        android:gravity="right|center"
        android:padding="15dp"
        android:textSize="18dp"
        app:layout_constraintStart_toEndOf="@+id/TextView1"
        app:layout_constraintTop_toTopOf="@+id/TextView1" />

    <Button
        android:id="@+id/bt_sales_invoice_popup_scan_item_add"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/btn_custom1"
        android:text="Add"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_sales_invoice_popup_scan_item_qty"
        app:layout_constraintTop_toTopOf="@+id/TextView1" />

    <Button
        android:id="@+id/bt_sales_invoice_popup_scan_item_close"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_sales_invoice_popup_scan_item_qty"
        app:layout_constraintTop_toTopOf="@+id/TextView12" />

</androidx.constraintlayout.widget.ConstraintLayout>
