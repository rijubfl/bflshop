        android:layout_height="0dp"
        android:background="@drawable/btn_custom1"
        android:text="Scan"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/et_aging_slash_popup_scan_barcode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_aging_slash_popup_scan_barcode" />

    <TextView
        android:id="@+id/tv_aging_slash_popup_scan_barcode"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom"
        android:hint="Scan Details"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_aging_slash_popup_scan_results" />

    <TextView
