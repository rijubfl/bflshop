<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.stocktaking.rfid.StockTakingRfidFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp">

        <TextView
            android:id="@+id/tv_grn_transfer_rfid_din_rec_date"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:hint="Date"
            android:padding="10dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_grn_transfer_rfid_shop" />

        <TextView
            android:id="@+id/tv_grn_transfer_rfid_user"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:hint=""
            android:padding="10dp"
            android:text="User"
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_grn_transfer_rfid_shop"
            app:layout_constraintStart_toEndOf="@+id/tv_grn_transfer_rfid_din_rec_date"
            app:layout_constraintTop_toTopOf="@+id/tv_grn_transfer_rfid_din_rec_date" />

        <TextView
            android:id="@+id/tv_grn_transfer_rfid_shop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:hint="Shop"
            android:padding="10dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/ly_grn_transfer_rfid_baterry_percentage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_grn_transfer_rfid_baterry_percentage"
            android:layout_width="100dp"
            android:layout_height="0dp"
            android:padding="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_grn_transfer_rfid_din_rec_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_grn_transfer_rfid_shop">

            <TextView
                android:id="@+id/TextView45"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/et_custom"
                android:gravity="center|center"
                android:hint=""
                android:padding="8dp"
                android:text="Battery"
                android:textColor="@color/coloBlack"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"></TextView>

            <TextView
                android:id="@+id/tv_ageing_slashing_battery_percentage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/et_custom"
                android:gravity="center|center"
                android:hint=""
                android:padding="0dp"
                android:text="100 %"
                android:textColor="@color/colorGreen"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/TextView45"></TextView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>